# Peak Ooru's settings. Copy to /etc/peak-ooru.env, owned by root and readable by the service's group only
# (chown root:peakooru, chmod 640): it may hold the mail password.

# Where the service listens. nginx passes /api to it; nothing else should reach it.
PORT=5210
HOST=127.0.0.1

# The store: one SQLite file, and the folder its backups go to.
STORE=/var/lib/peak-ooru/peak-ooru.db
# The share pictures, one PNG a finished ranked game (at most 400 KB each). Left unset: a folder `pictures` beside
# the store. The service must be able to write to it.
#PICTURES=/var/lib/peak-ooru/pictures

# The city's data, from the built game, so that the server and the browsers work from the same files.
DATA=/srv/peak-ooru/www/data

# Worker threads that work out months: one for each processor the game may use. A 2-processor machine: 2. See
# docs/DEPLOY.md, "How many players".
WORKERS=2
# Months that may wait for a worker before more are refused as too many.
QUEUE=16

# The game's address, for the link in a sign-in email.
PUBLIC_URL=https://GAME.EXAMPLE.COM

# Limits by address, counted in memory. Mobile carriers put many phones behind one address.
#NEW_PLAYERS_PER_HOUR=200
#REQUESTS_PER_MINUTE=600

# Requests come from nginx on this machine, which gives each one's address as X-Real-IP.
TRUST_PROXY=1

# Signing in by email. Leave SMTP_HOST unset and email sign-in says plainly that it is not set up.
# Port 465 is TLS from the start; any other port must offer STARTTLS.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Peak Ooru <no-reply@GAME.EXAMPLE.COM>

# Signing in with Google: the OAuth client id of the game (Google Cloud console, "Web application", with the game's
# address as an authorised JavaScript origin). Leave unset and Google sign-in says plainly that it is not set up.
# The screen needs the same id at build time (C's VITE_ setting).
#GOOGLE_CLIENT_ID=0000000000-xxxxxxxx.apps.googleusercontent.com
